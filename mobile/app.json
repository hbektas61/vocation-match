{
  "expo": {
    "name": "CheckMatches",
    "slug": "vocation-match",
    "scheme": "vocationmatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vocationmatch.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vocationmatch.app",
      "adaptiveIcon": {
        "backgroundColor": "#FDE4D7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "CheckMatches asks for a photo only when you choose to add one to your profile. It is stored privately and is visible only to people in a room with you or matched with you."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CheckMatches checks once, while you have the app open, whether you are within 500 metres of your hotel. It keeps only yes or no — never where you are, and never a distance anyone else can see.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "splash": {
      "image": "./assets/brand-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    }
  }
}
