# Copy to `.env.local` and fill in to point the app at a real Supabase project.
# Without these the app runs on the in-memory implementation in src/data/fakeApi.ts.
#
# Both values are public client credentials. Row level security is what protects
# the data — never put a service-role key in this file or anywhere in the app.
# Phone OTP also requires an SMS provider configured in the Supabase dashboard;
# provider secrets stay there and are never EXPO_PUBLIC variables.
# FakeApi is fail-closed unless EXPO_PUBLIC_USE_FAKE_API=true is set explicitly;
# use `npm run start:preview`, never this flag in a pilot/store build.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
